{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appleweiping/TopologyLantern/blob/main/docs/schemas/rule-sequence-checkpoint-1.schema.json",
  "title": "TopologyLantern rule-sequence statistical baseline checkpoint version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "model_kind", "sequence_count", "training_lineages",
    "training_spec_fingerprints", "training_sequence_sha256", "transitions",
    "checkpoint_sha256"
  ],
  "properties": {
    "schema": {"const": "org.topology-lantern.rule-sequence-checkpoint"},
    "version": {"const": 1},
    "model_kind": {"const": "laplace-bigram-rule-baseline"},
    "sequence_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "training_lineages": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "training_spec_fingerprints": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "training_sequence_sha256": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "transitions": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"$ref": "#/$defs/transition"}
    },
    "checkpoint_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule": {
      "enum": [
        "input.diff_pair", "input.common_source", "tail.current_source", "tail.resistor",
        "load.resistive", "load.active_mirror", "compensation.capacitor", "output.direct",
        "output.source_follower"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "next_rule", "count"],
      "properties": {
        "previous": {
          "anyOf": [{"const": "<start>"}, {"$ref": "#/$defs/rule"}]
        },
        "next_rule": {"$ref": "#/$defs/rule"},
        "count": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    }
  }
}
