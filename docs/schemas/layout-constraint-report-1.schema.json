{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appleweiping/TopologyLantern/blob/main/docs/schemas/layout-constraint-report-1.schema.json",
  "title": "TopologyLantern layout evidence report version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "graph_id", "user_constraints", "inferred_constraints", "disclaimer"],
  "properties": {
    "schema": {"const": "org.topology-lantern.layout-constraint-report"},
    "version": {"const": 1},
    "graph_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "user_constraints": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/outputConstraint"}
    },
    "inferred_constraints": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/inferredConstraint"}
    },
    "disclaimer": {"const": "Inferred constraints are evidence-backed candidates, not user requirements."}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "nodeId": {"type": "string", "pattern": "^tlg-[a-z]+-[0-9a-f]{20}$"},
    "subjects": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nodeId"}
    },
    "baseConstraint": {
      "type": "object",
      "required": ["id", "kind", "origin"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["symmetry", "common_centroid", "matching", "alignment", "order", "keepout", "net_priority"]},
        "origin": {"enum": ["user", "inferred"]},
        "subjects": {"$ref": "#/$defs/subjects"},
        "groups": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/subjects"}
        },
        "axis": {"type": "string"},
        "direction": {"type": "string"},
        "tolerance": {"type": "number"},
        "margin": {"type": "number"},
        "priority": {"type": "integer"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    },
    "kindShape": {
      "oneOf": [
        {
          "required": ["kind", "subjects", "axis"],
          "properties": {
            "kind": {"const": "symmetry"},
            "subjects": {"minItems": 2},
            "axis": {"enum": ["horizontal", "vertical"]}
          }
        },
        {
          "required": ["kind", "groups", "axis"],
          "properties": {
            "kind": {"const": "common_centroid"},
            "groups": {
              "minItems": 2,
              "maxItems": 2,
              "items": {"minItems": 1}
            },
            "axis": {"enum": ["horizontal", "vertical", "both"]}
          }
        },
        {
          "required": ["kind", "subjects", "tolerance"],
          "properties": {
            "kind": {"const": "matching"},
            "subjects": {"minItems": 2},
            "tolerance": {"minimum": 0}
          }
        },
        {
          "required": ["kind", "subjects", "axis"],
          "properties": {
            "kind": {"const": "alignment"},
            "subjects": {"minItems": 2},
            "axis": {"enum": ["x", "y"]}
          }
        },
        {
          "required": ["kind", "subjects", "direction"],
          "properties": {
            "kind": {"const": "order"},
            "subjects": {"minItems": 2},
            "direction": {"enum": ["left_to_right", "right_to_left", "bottom_to_top", "top_to_bottom"]}
          }
        },
        {
          "required": ["kind", "subjects", "margin"],
          "properties": {
            "kind": {"const": "keepout"},
            "subjects": {"minItems": 1},
            "margin": {"minimum": 0}
          }
        },
        {
          "required": ["kind", "subjects", "priority"],
          "properties": {
            "kind": {"const": "net_priority"},
            "subjects": {"minItems": 1},
            "priority": {"minimum": 0, "maximum": 100}
          }
        }
      ]
    },
    "outputConstraint": {
      "allOf": [
        {"$ref": "#/$defs/baseConstraint"},
        {"$ref": "#/$defs/kindShape"},
        {
          "properties": {"origin": {"const": "user"}},
          "not": {"anyOf": [{"required": ["confidence"]}, {"required": ["evidence"]}]}
        }
      ],
      "unevaluatedProperties": false
    },
    "inferredConstraint": {
      "allOf": [
        {"$ref": "#/$defs/baseConstraint"},
        {"$ref": "#/$defs/kindShape"},
        {
          "required": ["confidence", "evidence"],
          "properties": {"origin": {"const": "inferred"}}
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
