{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appleweiping/TopologyLantern/blob/main/docs/schemas/connectivity-graph-1.schema.json",
  "title": "TopologyLantern lossless connectivity graph version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "view", "representation_id", "source_graph_id",
    "top", "sources", "scopes"
  ],
  "properties": {
    "schema": {"const": "org.topology-lantern.connectivity-graph"},
    "version": {"const": 1},
    "view": {"enum": ["compact", "pin-level"]},
    "representation_id": {"$ref": "#/$defs/digest"},
    "source_graph_id": {"$ref": "#/$defs/digest"},
    "top": {"$ref": "#/$defs/text256"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text4096"}
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"view": {"const": "compact"}}, "required": ["view"]},
      "then": {"properties": {"scopes": {"items": {"$ref": "#/$defs/compactScope"}}}}
    },
    {
      "if": {"properties": {"view": {"const": "pin-level"}}, "required": ["view"]},
      "then": {"properties": {"scopes": {"items": {"$ref": "#/$defs/pinScope"}}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nodeId": {"type": "string", "pattern": "^tlg-[a-z]+-[0-9a-f]{20}$"},
    "derivedId": {"type": "string", "pattern": "^tlg-[a-z]+-[0-9a-f]{24}$"},
    "text128": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uFEFF]).+$"
    },
    "text256": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uFEFF]).+$"
    },
    "text4096": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uFEFF]).+$"
    },
    "stringMap": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {"$ref": "#/$defs/text256"},
      "additionalProperties": {"$ref": "#/$defs/text256"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"$ref": "#/$defs/text4096"},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "is_port", "is_global"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "name": {"$ref": "#/$defs/text256"},
        "is_port": {"type": "boolean"},
        "is_global": {"type": "boolean"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "index", "element_kind", "model", "reference",
        "reference_scope_id", "parameters", "effective_parameters", "source"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "name": {"$ref": "#/$defs/text256"},
        "kind": {"enum": ["port", "device", "instance"]},
        "index": {"type": ["integer", "null"], "minimum": 0},
        "element_kind": {
          "type": ["string", "null"],
          "enum": [
            "mosfet", "resistor", "capacitor", "current_source",
            "voltage_source", "diode", "bjt", null
          ]
        },
        "model": {"oneOf": [{"$ref": "#/$defs/text256"}, {"type": "null"}]},
        "reference": {"oneOf": [{"$ref": "#/$defs/text256"}, {"type": "null"}]},
        "reference_scope_id": {"oneOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
        "parameters": {"$ref": "#/$defs/stringMap"},
        "effective_parameters": {"$ref": "#/$defs/stringMap"},
        "source": {"oneOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "port"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "element_kind": {"type": "null"}, "model": {"type": "null"},
              "reference": {"type": "null"}, "reference_scope_id": {"type": "null"},
              "parameters": {"maxProperties": 0},
              "effective_parameters": {"maxProperties": 0}, "source": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "device"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "index": {"type": "null"},
              "element_kind": {"type": "string"},
              "reference": {"type": "null"}, "reference_scope_id": {"type": "null"},
              "effective_parameters": {"maxProperties": 0},
              "source": {"$ref": "#/$defs/source"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "instance"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "index": {"type": "null"}, "element_kind": {"type": "null"},
              "model": {"type": "null"}, "reference": {"$ref": "#/$defs/text256"},
              "reference_scope_id": {"$ref": "#/$defs/nodeId"},
              "source": {"$ref": "#/$defs/source"}
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_id", "terminal", "ordinal", "net_id"],
      "properties": {
        "id": {"$ref": "#/$defs/derivedId"},
        "owner_id": {"$ref": "#/$defs/nodeId"},
        "terminal": {"$ref": "#/$defs/text256"},
        "ordinal": {"type": "integer", "minimum": 0},
        "net_id": {"$ref": "#/$defs/nodeId"}
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_id", "terminal", "ordinal"],
      "properties": {
        "id": {"$ref": "#/$defs/derivedId"},
        "owner_id": {"$ref": "#/$defs/nodeId"},
        "terminal": {"$ref": "#/$defs/text256"},
        "ordinal": {"type": "integer", "minimum": 0}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pin_id", "net_id"],
      "properties": {
        "id": {"$ref": "#/$defs/derivedId"},
        "pin_id": {"$ref": "#/$defs/derivedId"},
        "net_id": {"$ref": "#/$defs/nodeId"}
      }
    },
    "scopeBase": {
      "type": "object",
      "required": ["id", "name", "parameters", "nets", "owners"],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "name": {"$ref": "#/$defs/text256"},
        "parameters": {"$ref": "#/$defs/stringMap"},
        "nets": {
          "type": "array", "maxItems": 100000, "uniqueItems": true,
          "items": {"$ref": "#/$defs/net"}
        },
        "owners": {
          "type": "array", "maxItems": 100000, "uniqueItems": true,
          "items": {"$ref": "#/$defs/owner"}
        }
      }
    },
    "compactScope": {
      "allOf": [
        {"$ref": "#/$defs/scopeBase"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "parameters", "nets", "owners", "edges"],
          "properties": {
            "id": true, "name": true, "parameters": true, "nets": true, "owners": true,
            "edges": {
              "type": "array", "maxItems": 500000, "uniqueItems": true,
              "items": {"$ref": "#/$defs/edge"}
            }
          }
        }
      ]
    },
    "pinScope": {
      "allOf": [
        {"$ref": "#/$defs/scopeBase"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "parameters", "nets", "owners", "pins", "links"],
          "properties": {
            "id": true, "name": true, "parameters": true, "nets": true, "owners": true,
            "pins": {
              "type": "array", "maxItems": 500000, "uniqueItems": true,
              "items": {"$ref": "#/$defs/pin"}
            },
            "links": {
              "type": "array", "maxItems": 500000, "uniqueItems": true,
              "items": {"$ref": "#/$defs/link"}
            }
          }
        }
      ]
    }
  }
}
