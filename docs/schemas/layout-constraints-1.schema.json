{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/appleweiping/TopologyLantern/blob/main/docs/schemas/layout-constraints-1.schema.json",
  "title": "TopologyLantern user layout constraints version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "graph_id", "constraints"],
  "properties": {
    "schema": {"const": "org.topology-lantern.layout-constraints"},
    "version": {"const": 1},
    "graph_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "constraints": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/constraint"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "nodeId": {"type": "string", "pattern": "^tlg-[a-z]+-[0-9a-f]{20}$"},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nodeId"}
    },
    "constraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjects", "axis"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "symmetry"},
            "subjects": {"$ref": "#/$defs/subjects", "minItems": 2},
            "axis": {"enum": ["horizontal", "vertical"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "groups", "axis"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "common_centroid"},
            "groups": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"$ref": "#/$defs/subjects"}
            },
            "axis": {"enum": ["horizontal", "vertical", "both"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjects", "tolerance"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "matching"},
            "subjects": {"$ref": "#/$defs/subjects", "minItems": 2},
            "tolerance": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjects", "axis"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "alignment"},
            "subjects": {"$ref": "#/$defs/subjects", "minItems": 2},
            "axis": {"enum": ["x", "y"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjects", "direction"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "order"},
            "subjects": {"$ref": "#/$defs/subjects", "minItems": 2},
            "direction": {"enum": ["left_to_right", "right_to_left", "bottom_to_top", "top_to_bottom"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjects", "margin"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "keepout"},
            "subjects": {"$ref": "#/$defs/subjects"},
            "margin": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "subjects", "priority"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "kind": {"const": "net_priority"},
            "subjects": {"$ref": "#/$defs/subjects"},
            "priority": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        }
      ]
    }
  }
}
